# Postgres connection string. Examples:
#   postgres://postgres:postgres@localhost:5432/inno
#   postgres://postgres@/inno?host=/var/run/postgresql        # local unix socket
DATABASE_URL=postgres://postgres:postgres@localhost:5432/inno

# HTTP port the Nest server listens on.
PORT=3000

# Comma-separated list of allowed CORS origins. Use * for any (dev only).
CORS_ORIGINS=*

# Shared secret guarding /api/admin/*. Required for the admin tool to work.
# Use at least 32 random characters in production.
ADMIN_TOKEN=dev-admin-token-change-me
