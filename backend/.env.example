# Postgres connection string. Examples:
#   postgres://postgres:postgres@localhost:5432/inno
#   postgres://postgres@/inno?host=/var/run/postgresql        # local unix socket
DATABASE_URL=postgres://postgres:postgres@localhost:5432/inno

# HTTP port the Nest server listens on.
PORT=3000

# Comma-separated list of allowed CORS origins. Use * for any (dev only).
CORS_ORIGINS=*

# JWT signing secret. Backend refuses to start if this is shorter than 16
# chars. Generate with: `openssl rand -hex 32`.
JWT_SECRET=dev-jwt-secret-please-change-min-16-chars
JWT_TTL=7d

# First admin bootstrap. The backend creates a row in users at startup if
# there's no admin yet. After first login, change the password and remove
# these env vars from the deploy.
BOOTSTRAP_ADMIN_EMAIL=admin@inno.local
BOOTSTRAP_ADMIN_PASSWORD=change-me-on-first-login
BOOTSTRAP_ADMIN_NAME=Admin
